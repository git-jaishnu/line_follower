void processSensors(Sensor_Array *sensor_array) {
	for (int i = 0; i < NUM_SENSORS; i++) {
		int raw = sensor_array->array[i].adc_raw;
		int th = sensor_array->array[i].threshold;

		// Hard-gating at threshold (raw>=th ? raw : 0) means the instant a
		// sensor crosses th its contribution to get_line_error() jumps
		// straight from 0 to its full raw value - the same kind of
		// discontinuity the analog error was meant to remove, just moved
		// one function over. This ramps the contribution up smoothly from
		// a floor below threshold instead of snapping it on, so a sensor
		// easing onto the line contributes gradually more instead of
		// appearing all at once. `on` (used for junction detection) stays
		// a clean binary threshold - that's a discrete classification and
		// is supposed to be hard-gated.
		int floor = th / 2; // starting point - raise it if noise/glare below
		                     // threshold is still leaking into mapped_value
		int contribution = raw - floor;
		if (contribution < 0)
			contribution = 0;

		sensor_array->array[i].mapped_value = contribution;
		sensor_array->array[i].on = (raw >= th);
	}
}

float get_line_error(Sensor_Array *sensor_array) {
	float weighted_sum = 0;
	float value_sum = 0;
	static float last_error = 0;

	for (int i = 0; i < NUM_SENSORS; i++) {
		weighted_sum += (float) (sensor_array->array[i].mapped_value)
				* (sensor_array->array[i].weight);
		value_sum += (float) sensor_array->array[i].mapped_value;
	}

	// value_sum == 0 means every sensor is below its floor - line lost, or
	// straddling a junction. weighted_sum/0 is NaN in IEEE754, and once a
	// NaN gets into pid->integral (which just keeps accumulating every
	// loop) it stays NaN forever - the whole controller is silently dead
	// until you reset it. Hold the last known direction instead, same as
	// before.
	if (value_sum < 1.0f)
		return last_error;

	float out = weighted_sum / value_sum;
	last_error = out;
	return out;
}

